rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ランキング用スコア（V2）
    // ドキュメントIDはFirebase匿名認証のUID。本人だけが自分のドキュメントを書き込める
    match /userScoresV2/{userId} {

      // 読み取り: 誰でも可能（ランキング表示用）
      allow read: if true;

      allow create: if isOwner(userId)
        && isValidDocument(request.resource.data, userId);

      allow update: if isOwner(userId)
        && isValidDocument(request.resource.data, userId)
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isOwner(userId);
    }

    // 旧ランキング（V1）: 認証導入前のデータ。閲覧のみ許可し、書き込みは受け付けない
    match /userScores/{userId} {
      allow read: if true;
      allow write: if false;
    }
  }

  function isOwner(userId) {
    return request.auth != null && request.auth.uid == userId;
  }

  function isValidDocument(data, userId) {
    return data.keys().hasOnly(['userId', 'displayName', 'createdAt', 'lastUpdated', 'challengeScores'])
      && data.userId == userId
      && data.displayName is string
      && data.displayName.size() >= 1
      && data.displayName.size() <= 20
      && data.createdAt is number
      && data.lastUpdated is number
      && data.challengeScores is map
      && data.challengeScores.keys().hasOnly(['easy', 'normal', 'hard'])
      && isValidScore(data.challengeScores.easy)
      && isValidScore(data.challengeScores.normal)
      && isValidScore(data.challengeScores.hard);
  }

  function isValidScore(score) {
    return score is map
      && score.keys().hasOnly(['score', 'timestamp', 'problemCount'])
      && score.score is number
      && score.score >= 0
      && score.score <= 999999
      && score.timestamp is number
      && score.problemCount is number
      && score.problemCount >= 0
      && score.problemCount <= 999;
  }
}
